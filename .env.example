# Required on the Dell. Local development may use the JSON fallback only when auth is explicitly bypassed.
DATABASE_URL=postgresql://perpendicular:change-me@postgres:5432/perpendicular

BLUEBLOOD_ID_ISSUER=https://id.bluebloodstudio.com
BLUEBLOOD_ID_API_ORIGIN=https://id.bluebloodstudio.com
BLUEBLOOD_ID_JWKS_URL=https://id.bluebloodstudio.com/api/.well-known/jwks.json
BLUEBLOOD_ID_PRODUCT_SLUG=perpendicular
PERPENDICULAR_WEB_ORIGIN=https://perpendicular.bluebloodstudio.com
# Exact browser origins allowed to call the API. Keep the canonical origin above
# for redirects, and include the connected Vercel deployment while it is live.
PERPENDICULAR_WEB_ORIGINS=https://perpendicular.bluebloodstudio.com,https://perpendicular-nine.vercel.app
PERPENDICULAR_API_ORIGIN=https://perpendicular-api.bluebloodstudio.com
NEXT_PUBLIC_CANONICAL_URL=https://perpendicular.bluebloodstudio.com
NEXT_PUBLIC_API_BASE_URL=
ALLOW_UNAUTHENTICATED_LOCAL=false
ALLOW_LOCAL_LLM_FALLBACK=false

# Google Cloud OAuth client for Gmail mailbox access. The redirect URI must be
# registered exactly as GOOGLE_GMAIL_REDIRECT_URI in Google Cloud Console.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=https://perpendicular-api.bluebloodstudio.com/api/integrations/google/callback

# 32-byte key, encoded as 64 hex chars or base64url. Generate once and keep on the Dell.
INTEGRATION_ENCRYPTION_KEY=
INITIAL_AI_CREDITS=1000
INITIAL_DATA_CREDITS=500

# Optional. The app uses Ollama when reachable and a deterministic local fallback otherwise.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional for the cron endpoint. Keep this server-only.
CRON_SECRET=replace-me

# The local default is used only with ALLOW_UNAUTHENTICATED_LOCAL=true.
DEFAULT_COMPANY_ID=blueblood-demo
